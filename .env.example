# ==========================================
# PATTERN GUARD - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Bright Data Scraping Configuration (Hackathon Sponsor)
# Get your credentials at: https://brightdata.com/cp/start
# You can provide either the full Scraping Browser WebSocket URL OR individual credentials.

# Option A: Scraping Browser WebSocket URL (Recommended for automated Playwright CDP)
# Format: wss://brd-customer-<CUSTOMER_ID>-zone-<ZONE_NAME>:<PASSWORD>@brd.superproxy.io:9222
BRIGHT_DATA_WSS_URL=

# Option B: Bright Data Proxy / Web Unlocker URL
# Format: http://brd-customer-<CUSTOMER_ID>-zone-<ZONE_NAME>:<PASSWORD>@brd.superproxy.io:22225
BRIGHT_DATA_PROXY_URL=

# Option C: Individual Credentials
BRIGHT_DATA_CUSTOMER_ID=
BRIGHT_DATA_ZONE_NAME=scraping_browser
BRIGHT_DATA_PASSWORD=
BRIGHT_DATA_ENABLED=true

# 2. AI Inference API Key (Optional: Groq, OpenAI, xAI)
GROQ_API_KEY=
OPENAI_API_KEY=

# 3. Server Configuration
## Supabase Postgres connection string. Leave empty to use local SQLite instead.
DATABASE_URL=
PORT=8000
HOST=0.0.0.0
MAX_CONCURRENT_SCANS=2
# Set true only when you intentionally want the ShopSneak/GymTrap demo records created.
SEED_DEMO_DATA=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Optional: require this value in the X-Pattern-Guard-Token header for scan endpoints.
SCAN_API_TOKEN=
# Authority Review (local demo credentials; override both values for deployment)
AUTHORITY_REVIEW_EMAIL=authority@ccpa.gov.in
AUTHORITY_REVIEW_PASSWORD=PatternGuardDemo2026!
# Set a long, unique random value before any non-demo deployment.
AUTHORITY_SESSION_SECRET=replace-with-a-long-random-secret
# Optional storage overrides, useful for isolated tests and ephemeral containers.
PATTERN_GUARD_DB_PATH=
PATTERN_GUARD_STATIC_DIR=

